PORT=8080
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only. Never put this key in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables the LLM fallback for voice phrases the rule parser cannot read.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Per-store daily cap on LLM fallback calls.
LLM_DAILY_CAP_PER_STORE=200
